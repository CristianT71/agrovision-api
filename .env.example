# ===========================
# Base de datos (PostgreSQL en Docker)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario
DB_PASSWORD=password
DB_NAME=databasename

# ===========================
# Seguridad
# ===========================
# Obligatorio: la API no arranca sin él. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Obligatorio: firma las URLs con las que la app móvil sube sus fotos (la API no arranca sin él).
# Genera uno distinto a JWT_SECRET con el mismo comando.
UPLOAD_URL_SECRET=

# Opcional: clave privada Ed25519 con la que se firman los modelos IA (PKCS#8 DER en Base64).
# Sin ella los modelos se suben sin firma y no se pueden publicar a los dispositivos.
# Genera el par con este comando; la clave pública que imprime va en la app (MODEL_SIGNING_PUBLIC_KEY):
# node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log('MODEL_SIGNING_PRIVATE_KEY='+k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('Pública para la app: '+Buffer.from(k.publicKey.export({format:'jwk'}).x,'base64url').toString('base64'))"
MODEL_SIGNING_PRIVATE_KEY=

# ===========================
# Servidor (opcionales)
# ===========================
PORT=3000
UPLOADS_DIR=uploads
# URL con la que la app móvil llega a esta API; se usa para armar las URLs de subida de fotos.
# 10.0.2.2 es el localhost del PC visto desde el emulador de Android.
# En un celular físico usa la IP del PC en la red (ej. http://192.168.1.20:3000).
API_PUBLIC_URL=http://10.0.2.2:3000

# ===========================
# SMS real con Zavu (opcional: en desarrollo el código sale en la consola)
# ===========================
ZAVU_API_URL=https://api.zavu.dev/v1/messages
ZAVU_API_KEY=tu_token_aqui
ZAVU_SENDER_ID=
