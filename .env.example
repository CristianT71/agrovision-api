# ===========================
# Base de datos (PostgreSQL en Docker)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario
DB_PASSWORD=password
DB_NAME=databasename

# ===========================
# Seguridad
# ===========================
# Obligatorio: la API no arranca sin él. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Obligatorio: firma las URLs con las que la app móvil sube sus fotos (la API no arranca sin él).
# Genera uno distinto a JWT_SECRET con el mismo comando.
UPLOAD_URL_SECRET=
# Obligatorio: firma los medios privados de vuelos. Genera un secreto distinto de los dos anteriores.
VUELOS_URL_SECRET=
# Tamaño máximo por archivo de vuelo en MB (por defecto 2048).
VUELOS_MAX_ARCHIVO_MB=2048

# Opcional: clave privada Ed25519 con la que se firman los modelos IA (PKCS#8 DER en Base64).
# Sin ella los modelos se suben sin firma y no se pueden publicar a los dispositivos.
# Genera el par con este comando; la clave pública que imprime va en la app (MODEL_SIGNING_PUBLIC_KEY):
# node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log('MODEL_SIGNING_PRIVATE_KEY='+k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('Pública para la app: '+Buffer.from(k.publicKey.export({format:'jwk'}).x,'base64url').toString('base64'))"
MODEL_SIGNING_PRIVATE_KEY=

# ===========================
# Servidor (opcionales)
# ===========================
PORT=3000
# Orígenes del panel que pueden llamar a la API, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:5173
# En producción: CORS_ORIGINS=https://agrovision.sbs
# Cuántos proxies hay delante de la API (0 = ninguno). Con un túnel de dev tunnels, nginx o un balanceador
# pon 1: así el límite de peticiones por IP cuenta a cada usuario y no a todos juntos.
TRUST_PROXY=0
UPLOADS_DIR=uploads
# URL con la que la app móvil llega a esta API; se usa para armar las URLs de subida de fotos.
# 10.0.2.2 es el localhost del PC visto desde el emulador de Android.
# En un celular físico usa la IP del PC en la red (ej. http://192.168.1.20:3000).
API_PUBLIC_URL=http://10.0.2.2:3000
# En producción: API_PUBLIC_URL=https://agrovision.sbs
# El sync público del catálogo exige HTTPS en esta variable cuando haya fotos publicables.

# ===========================
# Códigos OTP
# ===========================
# log  = el código sale en la consola de la API (desarrollo, no cuesta dinero).
# zavu = se envía de verdad por Zavu. Con NODE_ENV=production solo se permite zavu.
SMS_PROVIDER=log
# Canal de Zavu: auto (Zavu elige), sms o whatsapp (WhatsApp exige una plantilla aprobada en Zavu)
ZAVU_CHANNEL=auto
ZAVU_API_URL=https://api.zavu.dev/v1/messages
ZAVU_API_KEY=tu_token_aqui
ZAVU_SENDER_ID=

# Notificaciones por correo. log = solo consola; smtp = envío real.
# Con Gmail: activa la verificación en dos pasos y crea una contraseña de aplicación
# (myaccount.google.com/apppasswords). MAIL_PASSWORD es esa de 16 letras, NO la de la cuenta.
MAIL_PROVIDER=log
MAIL_USER=
MAIL_PASSWORD=
# Opcionales: MAIL_FROM="AgroVision <correo@gmail.com>", MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true

# ===========================
# Elevación (altitud sobre el nivel del mar del detalle y mapa de solicitudes)
# ===========================
# google = consulta la API de Elevación de Google la primera vez que se pide la ubicación de una solicitud
# sin altitud del GPS; none = solo se muestra la altitud que mande el celular.
# La clave vive solo en el servidor: restríngela en Google Cloud a la API de Elevación y a la IP del servidor.
ELEVATION_PROVIDER=none
GOOGLE_ELEVATION_API_KEY=

# ===========================
# n8n (asistente de IA, opcional) — ver n8n/README.md
# ===========================
# Obligatoria para levantar n8n. Cifra las credenciales guardadas en n8n (por ejemplo la API key de Fireworks).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala bien: si cambia, las credenciales guardadas dejan de poder descifrarse.
N8N_ENCRYPTION_KEY=
# URL pública de los webhooks (la que va en VITE_N8N_CHAT_WEBHOOK_URL del panel).
# En local: http://localhost:5679/    Publicado por el túnel: https://n8n.agrovision.sbs/
N8N_WEBHOOK_URL=http://localhost:5679/

# Llave de solo lectura para que n8n consulte los vuelos (GET /api/servicio/vuelos), sin sesión de usuario.
# Mínimo 32 caracteres. Sin ella, esa ruta queda cerrada. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La misma llave se guarda en n8n como credencial «Header Auth» (nombre de cabecera: X-Api-Key).
N8N_API_KEY=
