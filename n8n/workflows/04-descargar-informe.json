        "path": "informe",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "be427cb4-af10-5a70-bbce-8b271e5cb2c3",
      "name": "Webhook informe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
