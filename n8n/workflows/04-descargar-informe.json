      ],
      "webhookId": "0fd9f8ba-3b75-568a-8604-7e9839b0a786"
    },
    {
      "parameters": {
        "jsCode": "// El enlace trae ?t=<vencimiento>-<48 caracteres>. Se valida el formato (esto impide rutas raras como ../)\n// y que no haya vencido, antes de tocar el disco.\n// Se tolera un \".pdf\" final (el asistente a veces lo añade al copiar el enlace); el formato sigue validándose por completo.\nconst t = String(($input.first().json.query && $input.first().json.query.t) || '').replace(/\\.pdf$/i, '');\nconst m = /^(\\d{10})-([a-f0-9]{48})$/.exec(t);\nif (!m) return [{ json: { estado: 400, mensaje: 'Enlace no válido.' } }];\nif (Number(m[1]) * 1000 < Date.now()) return [{ json: { estado: 410, mensaje: 'El enlace venció. Pide un informe nuevo.' } }];\nreturn [{ json: { estado: 200, archivo: t + '.pdf' } }];"
      },
      "id": "389f6ab1-9188-5fb2-8627-d7346bf97ff8",
      "name": "Validar enlace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.estado }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2f0f55b1-1549-58de-8c3b-ca127ac912d9",
      "name": "¿Enlace válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
