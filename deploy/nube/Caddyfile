# Proxy con certificado https automático (Let's Encrypt). DOMINIOS sale del .env del servidor
# (una o varias direcciones separadas por coma, por ejemplo: agrovision.sbs, nube.agrovision.sbs).
# Sirve el panel (archivos estáticos en /srv/panel) y reenvía /api y /archivos a la API.
{$DOMINIOS} {
	encode zstd gzip

	# Los vuelos llegan a 2 GB por archivo
	request_body {
		max_size 2100MB
	}

	@api path /api/* /archivos/*
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}
}
