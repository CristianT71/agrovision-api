# Proxy con certificado https automático (Let's Encrypt). DOMINIOS sale del .env del servidor
# (una o varias direcciones separadas por coma, por ejemplo: agrovision.sbs, nube.agrovision.sbs).
# Sirve el panel (archivos estáticos en /srv/panel) y reenvía /api y /archivos a la API.
{$DOMINIOS} {
	encode zstd gzip

	# Los vuelos llegan a 2 GB por archivo
	request_body {
		max_size 2100MB
	}

	@api path /api/* /archivos/*
	handle @api {
		reverse_proxy api:3000
	}

	# Descarga pública de la app: /descargas es una página del panel y /descargas/archivos/ guarda el APK
	# y su version.json (se copian al servidor sin recompilar el panel)
	@descargas path /descargas/archivos/*
	handle @descargas {
		uri strip_prefix /descargas/archivos
		root * /srv/descargas
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# El panel: los archivos de /assets llevan el hash en el nombre y se pueden guardar para siempre; todo lo demás
	# (index.html y las rutas del panel) no se guarda, para que una versión nueva se vea sin Ctrl+F5.
	handle {
		root * /srv/panel
		@assets path /assets/*
		@noassets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @noassets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
